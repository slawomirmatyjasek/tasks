---
import Layout from "@/layouts/Layout.astro";

/**
 * Ekran po rejestracji, która NIE zwróciła od razu sesji — czyli gdy projekt
 * Supabase wymaga potwierdzenia adresu. Przy wyłączonym potwierdzaniu
 * `/api/auth/signup` przekierowuje prosto na /dashboard i ta strona się
 * nie pojawia.
 */
---

<Layout title="Potwierdź adres e-mail — Pilne">
  <div class="bg-cosmic flex min-h-screen items-center justify-center p-4">
    <div
      class="w-full max-w-sm rounded-2xl border border-white/10 bg-white/10 p-8 text-center text-white backdrop-blur-xl"
    >
      <div class="mb-4 text-5xl">📧</div>
      <h1 class="mb-3 text-2xl font-semibold text-white/90">Sprawdź pocztę</h1>
      <p class="mb-6 text-blue-100/80">
        Konto zostało utworzone. Wysłaliśmy link aktywacyjny na podany adres — kliknij go, a potem zaloguj się do
        aplikacji.
      </p>
      <a href="/auth/signin" class="text-sm text-purple-300 hover:underline"> Wróć do logowania </a>
    </div>
  </div>
</Layout>
