---
import Layout from "@/layouts/Layout.astro";
import SignUpForm from "@/components/auth/SignUpForm";

const error = Astro.url.searchParams.get("error");
---

<Layout title="Załóż konto — Pilne">
  <div class="bg-cosmic flex min-h-screen items-center justify-center p-4">
    <div class="w-full max-w-sm">
      <div class="mb-6 text-center">
        <a
          href="/"
          class="bg-gradient-to-r from-blue-200 via-purple-200 to-pink-200 bg-clip-text text-3xl font-bold text-transparent"
        >
          Pilne
        </a>
        <p class="mt-2 text-sm text-blue-100/60">Twoje zadania widzisz tylko Ty.</p>
      </div>

      <div class="rounded-2xl border border-white/10 bg-white/10 p-8 text-white backdrop-blur-xl">
        <h1 class="mb-6 text-center text-xl font-semibold text-white/90">Załóż konto</h1>
        <SignUpForm serverError={error} client:load />
        <p class="mt-4 text-center text-sm text-blue-100/60">
          Masz już konto? <a href="/auth/signin" class="text-purple-300 hover:underline">Zaloguj się</a>
        </p>
      </div>
    </div>
  </div>
</Layout>
