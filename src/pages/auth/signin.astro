---
import Layout from "@/layouts/Layout.astro";
import SignInForm from "@/components/auth/SignInForm";

const error = Astro.url.searchParams.get("error");
---

<Layout title="Logowanie — Pilne">
  <div class="bg-cosmic flex min-h-screen items-center justify-center p-4">
    <div class="w-full max-w-sm">
      <div class="mb-6 text-center">
        <a
          href="/"
          class="bg-gradient-to-r from-blue-200 via-purple-200 to-pink-200 bg-clip-text text-3xl font-bold text-transparent"
        >
          Pilne
        </a>
        <p class="mt-2 text-sm text-blue-100/60">Lista zadań, która sama pokazuje, co jest na już.</p>
      </div>

      <div class="rounded-2xl border border-white/10 bg-white/10 p-8 text-white backdrop-blur-xl">
        <h1 class="mb-6 text-center text-xl font-semibold text-white/90">Zaloguj się</h1>
        <SignInForm serverError={error} client:load />
        <p class="mt-4 text-center text-sm text-blue-100/60">
          Nie masz jeszcze konta? <a href="/auth/signup" class="text-purple-300 hover:underline">Załóż konto</a>
        </p>
      </div>
    </div>
  </div>
</Layout>
