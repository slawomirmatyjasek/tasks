---
import Layout from "@/layouts/Layout.astro";

/**
 * Wizytówka aplikacji dla niezalogowanego gościa (FR-002).
 *
 * Zalogowanego użytkownika nie ma tu czego szukać — na /dashboard odsyła go
 * middleware (`GUEST_ONLY_ROUTES`), więc ta strona nie potrzebuje własnej
 * gałęzi przekierowania.
 */
---

<Layout title="Pilne — lista zadań z automatyczną flagą pilności">
  <div class="bg-cosmic relative min-h-screen w-full overflow-hidden">
    <div
      class="pointer-events-none absolute top-1/4 -left-24 h-[350px] w-[350px] rounded-full bg-purple-500/20 blur-[120px]"
    >
    </div>
    <div
      class="pointer-events-none absolute top-2/3 -right-16 h-[250px] w-[250px] rounded-full bg-blue-500/15 blur-[100px]"
    >
    </div>

    <div class="relative z-10 mx-auto flex min-h-screen max-w-3xl flex-col items-center justify-center px-6 py-16">
      <h1
        class="mb-5 bg-gradient-to-r from-blue-200 via-purple-200 to-pink-200 bg-clip-text text-center text-5xl font-bold text-transparent sm:text-6xl"
      >
        Pilne
      </h1>

      <p class="mb-8 max-w-xl text-center text-lg text-blue-100/80">
        Lista zadań, która sama pokazuje, czym trzeba zająć się teraz.
      </p>

      <div class="mb-10 w-full max-w-xl rounded-2xl border border-white/10 bg-white/5 p-6 backdrop-blur-xl">
        <p class="text-center text-base text-white/90">
          Zadanie z terminem w ciągu <strong class="font-semibold text-purple-200">48 godzin</strong>, którego nie
          odhaczyłeś, dostaje flagę <span class="font-semibold text-pink-200">pilne</span>.
        </p>
        <p class="mt-3 text-center text-sm text-blue-100/60">
          Odhaczone zadanie od razu przestaje być pilne i zsuwa się na koniec listy — a odhaczenie zawsze da się cofnąć.
        </p>
        <p class="mt-3 text-center text-sm text-blue-100/60">
          Bez ręcznego ustawiania priorytetów. Flaga jest wyliczana przy każdym otwarciu listy, więc nigdy się nie
          dezaktualizuje.
        </p>
      </div>

      <div class="flex w-full max-w-xs flex-col gap-3 sm:max-w-md sm:flex-row sm:justify-center">
        <a
          href="/auth/signin"
          class="rounded-lg bg-purple-600 px-6 py-3 text-center font-medium text-white transition-colors hover:bg-purple-500"
        >
          Zaloguj się
        </a>
        <a
          href="/auth/signup"
          class="rounded-lg border border-white/15 px-6 py-3 text-center font-medium text-white/90 transition-colors hover:border-white/30 hover:bg-white/5"
        >
          Załóż konto
        </a>
      </div>
    </div>
  </div>
</Layout>
